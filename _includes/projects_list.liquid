{% raw %}<div class="publication">
  <p class="title">{{ project.title }}</p>
  <p class="authors">{{ project.authors }}</p>
  <p class="venue"><em>{{ project.venue }}</em>, {{ project.year }}</p>

  <div class="links">
    {% if project.pdf %}
      <a href="{{ project.pdf | relative_url }}" class="btn btn-sm z-depth-0" role="button" target="_blank">PDF</a>
    {% endif %}
    {% if project.website %}
      <a href="{{ project.website }}" class="btn btn-sm z-depth-0" role="button" target="_blank">Website</a>
    {% endif %}

    {% if project.abstract %}
      <details>
        <summary>Abstract</summary>
        <div class="abstract">
          <blockquote>
            {{ project.abstract | markdownify }}
          </blockquote>
        </div>
      </details>
    {% endif %}
  </div>
</div>
<hr> {% endraw %}
